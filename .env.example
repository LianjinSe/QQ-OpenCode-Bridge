# 无凭据示例；建议先运行 deploy/configure.py 生成当前机器的绝对路径。
NAPCAT_WS_URL=ws://127.0.0.1:3001
# OneBot Token, separate from the NapCat WebUI login token.
NAPCAT_TOKEN=
# 私聊用户白名单；授权群内成员无需列入（超级管理员仍必须列入）。
ALLOWED_USERS=
# Empty means private chats only.
ALLOWED_GROUPS=
# Optional Agent owner. This QQ user's private AND group tasks are automatically approved.
# Must also be present in ALLOWED_USERS. Empty keeps normal approval rules for everyone.
SUPERADMIN_USER_ID=
# Full action names of MCP tools verified read-only, e.g. docs_search,filesystem_read_file.
# Unknown MCP tools go to the group superadmin for approval.
GROUP_READONLY_MCP_ACTIONS=
EXCLUDED_PREFIXES=ww,mm,codex,core
OPENCODE_WORKDIR=~/qq-agent-workspace
# Discover URL and authentication from OpenCode's private service registration.
OPENCODE_SERVICE_FILE=~/.local/state/opencode/service.json
OPENCODE_BINARY=opencode
OPENCODE_AUTOSTART=true
# Optional explicit server override; empty uses service discovery.
OPENCODE_URL=
OPENCODE_PASSWORD=
OPENCODE_USERNAME=opencode
# Optional provider/model override; empty uses OpenCode's existing default.
OPENCODE_MODEL=
# 文生图和参考图编辑使用 OpenAI Images API；内部读取同一供应商的 baseURL/apiKey。
# 开启后可直接说“帮我画一只猫”；群聊需 @机器人并遵守操作审批。
IMAGE_GENERATION_ENABLED=false
IMAGE_PROVIDER=custom
IMAGE_MODEL=your-image-model
IMAGE_OPENCODE_CONFIG=~/.config/opencode/opencode.json
IMAGE_TIMEOUT=600
STATE_DB=~/qq-bridge-data/bridge.sqlite3
EXECUTION_TIMEOUT=3600
INTERACTION_TIMEOUT=600
STAGING_TTL=600
MAX_ATTACHMENTS=50
MAX_ATTACHMENT_BYTES=104857600
DOWNLOAD_TIMEOUT=120
POLL_INTERVAL=1
REPLY_CHUNK_SIZE=1800
# 仅文字发送前模拟打字：字数 / 每秒字数，并限制在最短、最长延迟之间（秒）。
TEXT_TYPING_CHARS_PER_SECOND=20
TEXT_TYPING_MIN_DELAY=0.5
TEXT_TYPING_MAX_DELAY=3
# 私聊任务执行期间显示“正在输入”；NapCat 此接口不支持群聊。
TYPING_STATUS_ENABLED=true
# Refresh while processing, in seconds; progress messages also trigger a refresh.
TYPING_REFRESH_INTERVAL=5
# 每个聊天未完成任务和待提交插话的合计上限；已提交的插话不再占待处理名额。
MAX_QUEUED_PER_CONTEXT=10
LOG_LEVEL=INFO

# Owner-only persistent memory (disabled until configured).
MEMORY_ENABLED=false
# Empty defaults to SUPERADMIN_USER_ID.
MEMORY_OWNER_USER_ID=
SILICONFLOW_API_KEY=
MEMORY_DATABASE_URL=
MEMORY_DB=~/qq-bridge-data/memory.sqlite3
MEMORY_BASE_URL=https://api.siliconflow.cn/v1
MEMORY_MODEL=deepseek-ai/DeepSeek-V3.2
MEMORY_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
MEMORY_RERANK_MODEL=Qwen/Qwen3-Reranker-8B
MEMORY_DIMENSIONS=1024
MEMORY_RERANK_ENABLED=true
MEMORY_TIMEOUT=90
MEMORY_SEARCH_TIMEOUT=8
MEM0_TELEMETRY=false

# Shared group background; only explicit mentions/commands trigger work.
GROUP_BACKGROUND_TTL_SECONDS=86400
GROUP_BACKGROUND_MAX_MESSAGES=200
GROUP_BACKGROUND_MAX_CHARS=20000
# Diagnostics contain identifiers/status codes, not message bodies or attachments.
DIAGNOSTIC_TTL_SECONDS=604800
DIAGNOSTIC_MAX_EVENTS=100000
## 独立账号密码管理台（通过 Nginx HTTPS 反向代理）
WEBUI_ENABLED=false
WEBUI_HOST=127.0.0.1
WEBUI_PORT=8093
WEBUI_PUBLIC_URL=


# LlamaIndex 文档知识库；独立于 Mem0，复用上述 SiliconFlow 与 PostgreSQL 连接。
# 需要 SUPERADMIN_USER_ID；数据位于 STATE_DB 同目录的 knowledge/。
KNOWLEDGE_ENABLED=false

# NapCat 全接口原生工具，实际调用仅真实超级管理员可用。
# 参数目录绑定本机 NapCat 版本；Cookie／密钥只通过本轮不透明引用使用。
NAPCAT_TOOLS_ENABLED=false

# 附件即时发送：模型调用 qq_send_files 后立刻发往聊天，正文仍等任务结束。
# 设为 false 则退回“任务成功结束后统一交付附件”的旧行为。
DELIVERY_IMMEDIATE=false
